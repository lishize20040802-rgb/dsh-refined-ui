{
  "name": "dsh-refined-ui",
  "version": "0.6.0",
  "description": "DeepSeek Harness dual-face plugin: a refined look for the web UI — calmer neutrals (light + dark), tidier text, and snappier, quieter motion. CSS-only; keeps DSH's own brand blue.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "theme"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.7",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.7",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.7",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.7"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.1.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    }
  }
}