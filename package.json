{
  "name": "dsh-refined-ui",
  "version": "0.2.0",
  "description": "DeepSeek Harness dual-face plugin: a refined look for the web UI — calmer neutrals (light + dark), tidier text, and snappier, quieter motion. CSS-only; keeps DSH's own brand blue.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "theme"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.1.7"
  }
}